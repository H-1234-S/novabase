# ===== 服务 =====
PORT=3000

# web 站点地址（OAuth 登录成功后跳回这里）
WEB_URL=http://localhost:3001

# 本服务的对外地址，必须带 /api 前缀（Swagger、项目 API 文档用）
API_URL=http://localhost:3000/api

NODE_ENV=development

# 可选 —— 需要走代理访问外网时填，例如 http://127.0.0.1:7897
# 注意：只有真的配了代理才会启用，且 localhost / 127.0.0.1 始终直连
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1,::1

# ===== 数据库（Neon）=====
# console.neon.tech -> Connection string
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# 可选 —— 连接池地址（serverless 环境用）
DATABASE_URL_POOLED=

# 可选 —— Realtime 的 LISTEN/NOTIFY 单独连接，不填则回落到 DATABASE_URL
REALTIME_DATABASE_URL=

# ===== 控制台登录 JWT =====
# 生成：openssl rand -base64 32
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== 项目 API Key（anon / service_role）=====
# 生成：openssl rand -base64 32
PROJECT_JWT_SECRET=your-project-jwt-secret-here

# ===== 组织邀请 =====
# 生成：openssl rand -base64 32
INVITE_SECRET=your-invite-secret-here

# ===== Google OAuth（控制台登录）=====
# console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ===== GitHub OAuth（控制台登录）=====
# github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# ===== 邮件（组织邀请 + 魔法链接）=====
# resend.com
RESEND_API_KEY=
# 备用 SMTP（nodemailer）
EMAIL_USER=
EMAIL_PASSWORD=

# ===== 文件存储 =====
# uploadthing.com 控制台
UPLOADTHING_TOKEN=
