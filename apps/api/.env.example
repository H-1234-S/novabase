# apps/api 环境变量示例：复制为 .env 后填入真实值
# cp apps/api/.env.example apps/api/.env

NODE_ENV=development
PORT=3000

# 数据库（必填）
DATABASE_URL=postgres://user:password@localhost:5432/novabase
# 实时模块使用的连接串，未设置时回退到 DATABASE_URL
REALTIME_DATABASE_URL=

# 服务自身与前端地址（必填，用于 Cookie、回调和 CORS）
API_URL=http://localhost:3000
WEB_URL=http://localhost:3001

# JWT（必填）
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# 终端用户项目侧 JWT 与邀请链接签名
PROJECT_JWT_SECRET=
INVITE_SECRET=

# 邮件：RESEND 与 SMTP 二选一
RESEND_API_KEY=
EMAIL_USER=

# 第三方登录（可选，未配置则对应 provider 不可用）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# 文件上传（可选）
UPLOADTHING_CALLBACK_URL=http://localhost:3000/api/uploadthing

# 实时事件清理任务保留时长（小时）
REALTIME_OUTBOX_RETENTION_HOURS=24
