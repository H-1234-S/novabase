# ===== 服务端 =====

# NestJS API（必须带 /api 前缀）
# 供 Server Component、Server Action 以及 /api/proxy 代理路由使用
API_URL=http://localhost:3000/api

# 中间件校验 access token 用，必须和后端 JWT_ACCESS_SECRET 保持一致
JWT_ACCESS_SECRET=your-access-secret-here

# ===== 浏览器侧 =====

# 本地开发填完整地址；生产环境留空即可自动走同源 /api/proxy
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# 可选 —— OAuth 登录后用户落地的站点地址（默认 http://localhost:3001）
NEXT_PUBLIC_WEB_URL=http://localhost:3001

# 可选 —— Realtime WebSocket 的 origin（默认取 API 地址去掉 /api）
# 生产环境如果 API 和 web 不同域，需要显式指定
# NEXT_PUBLIC_REALTIME_URL=http://localhost:3000
