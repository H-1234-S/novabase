# apps/web 环境变量示例：复制为 .env 后填入真实值
# cp apps/web/.env.example apps/web/.env

# 浏览器侧访问 API 的地址（必填，会打包进客户端）
NEXT_PUBLIC_API_URL=http://localhost:3000
# 浏览器侧自身地址（必填）
NEXT_PUBLIC_WEB_URL=http://localhost:3001

# 服务端（RSC / Route Handler）访问 API 的地址（必填）
API_URL=http://localhost:3000

# 服务端校验 Cookie 中的访问令牌（必填，需与 apps/api 的 JWT_ACCESS_SECRET 一致）
JWT_ACCESS_SECRET=
